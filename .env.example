# Plantilla de la conexión a AWS. NO pongas llaves reales en este archivo: este sí se sube al repo.
# Cópialo como .env (ignorado por git) y reemplaza los valores. Guía: docs/02_conexion_aws.md

AWS_ACCESS_KEY_ID=pon_aqui_la_access_key
AWS_SECRET_ACCESS_KEY=pon_aqui_la_secret_key
AWS_DEFAULT_REGION=us-east-1
ATHENA_S3_OUTPUT=s3://nombre-del-bucket/athena-results/
